logs/
lightning_logs/
mlruns/
wandb/
runs/
checkpoints/
*.keras
*.h5
*.hdf5
*.ckpt
*.pb
*.tflite
*.onnx
*.pt
*.pth
*.pkl
*.pickle
*.joblib
*.npy
*.npz

# ---------------------------------------------------------------
# Data: raw/large datasets stay local; keep small, shareable ones
# by adding a `!` exception below if you need them in git.
# ---------------------------------------------------------------
data/raw/
data/interim/
data/external/
data/processed/
*.parquet
*.feather
*.arrow
*.sqlite
*.db

# ---------------------------------------------------------------
# Generated output
# ---------------------------------------------------------------
output/
outputs/
tmp/
temp/
scratch/
*.tmp
*.bak
*.swp
*~

# ---------------------------------------------------------------
# Docs build
# ---------------------------------------------------------------
docs/_build/
site/

# ---------------------------------------------------------------
