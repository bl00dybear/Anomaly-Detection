# ---------------------------------------------------------------
# Python: bytecode, packaging, caches
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/
share/python-wheels/
pip-wheel-metadata/
MANIFEST
*.manifest
*.spec
.installed.cfg
pip-log.txt
pip-delete-this-directory.txt

# ---------------------------------------------------------------
# uv / virtual environments
# (keep .python-version and uv.lock TRACKED; they pin the Python and dependencies)
# ---------------------------------------------------------------
.venv/
venv/
ENV/
env/
.uv/

# ---------------------------------------------------------------
# Tool caches
# ---------------------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.nox/
.tox/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.cache/

# ---------------------------------------------------------------
# Jupyter / IPython
# ---------------------------------------------------------------
.ipynb_checkpoints/
profile_default/
ipython_config.py

# ---------------------------------------------------------------
# Environment and secrets
# ---------------------------------------------------------------
.env
.env.*
!.env.example
.envrc
*.pem
*.key
secrets.*

# ---------------------------------------------------------------
# ML / deep learning: training runs, checkpoints, saved models
